# Hoymiles DTU
HOYMILES_DTU_IP=192.168.1.XXX

# Wallbox — use token OR email+password (token takes priority)
WALLBOX_CHARGER_ID=XXXXXXXX
WALLBOX_TOKEN=
WALLBOX_EMAIL=email@example.com
WALLBOX_PASSWORD=secret

# MQTT
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=ems
MQTT_PASSWORD=secret

# InfluxDB — token must match DOCKER_INFLUXDB_INIT_ADMIN_TOKEN in docker-compose.yml
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=ems-admin-token
INFLUXDB_ORG=ems
INFLUXDB_BUCKET=ems

# EMS Config
EMS_DEFAULT_MODE=manual
EMS_THRESHOLD_ON_W=1400
EMS_THRESHOLD_OFF_W=500
EMS_HISTERESI_MINUTS=5
EMS_VOLTAGE=230
EMS_PHASES=3
EMS_POLL_INTERVAL_S=30

# API
API_HOST=0.0.0.0
API_PORT=8000
